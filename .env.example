OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# 선택. API와 평가 CLI가 함께 읽는 실행 설정과 자원 연결(docs/guides/local-bc.md)
# ADEN_CONFIG=configs/advanced.yaml
# ADEN_QDRANT_CLIENT=<모듈>:<settings를 받아 색인을 적재한 QdrantClient를 반환하는 함수>
# ADEN_EVIDENCE_PROVIDER=<모듈>:<settings를 받아 evidence_provider를 반환하는 함수>
