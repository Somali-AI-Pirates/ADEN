OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# 선택. API와 평가 CLI가 함께 읽는 실행 설정과 자원 연결(docs/guides/local-bc.md)
# ADEN_CONFIG=configs/advanced.yaml
# ADEN_QDRANT_CLIENT=<모듈>:<settings를 받아 색인을 적재한 QdrantClient를 반환하는 함수>
# ADEN_EVIDENCE_PROVIDER=<모듈>:<settings를 받아 evidence_provider를 반환하는 함수>

# Advanced 기본 DB 우선 TableRAG. 경로와 장치를 바꿀 때 지정한다.
# ADEN_TABLE_RAG_DIR=artifacts/advanced-table-rag
# ADEN_TABLE_RAG_DEVICE=cpu
# Langfuse 키가 있으면 상세 추적을 전송한다. 로컬 실행만 할 때 0으로 지정한다.
# ADEN_TABLE_RAG_TRACE=1

# Advanced TableRAG 벡터 검색 backend. 코드 기본값은 numpy이며 오프라인 경로를 유지한다.
# Qdrant Cloud quickstart를 따를 때는 로컬 .env에서 qdrant로 설정한다.
# ADEN_TABLE_RAG_VECTOR_BACKEND=numpy
# 컬렉션 기본값 advanced_table_rag. 추가 이름은 advanced_table_rag_ 접두사만 허용한다.
# ADEN_TABLE_RAG_COLLECTION=advanced_table_rag
# Qdrant Cloud credentials; 실제 값은 로컬 .env에만 보관한다.
# Qdrant Cloud 주소는 https:// 형식이어야 한다. API 키는 URL에 넣지 않는다.
QDRANT_URL=
QDRANT_API_KEY=
