{
  "name": "aden-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/pdf-assets.mjs && next build",
    "typecheck": "tsc --noEmit",
