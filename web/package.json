    "test:e2e": "playwright test",
    "postinstall": "node scripts/pdf-assets.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.36",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-pdf": "11.0.0",
    "remark-breaks": "4.0.0",
    "remark-cjk-friendly": "2.3.4",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4",
    "typescript": "^5"
  }
