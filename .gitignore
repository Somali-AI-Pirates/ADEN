# Python 바이트코드
__pycache__/
*.py[cod]

# 가상환경과 비밀값 (.env.example만 공유)
.venv
env/
venv/
ENV/
.env
.env.*
!.env.example
/configs/local.yaml
.envrc
.pypirc

# setuptools 빌드·배포 산출물
/build/
/dist/
/*.egg-info/

# 현재 사용하는 검사 도구의 캐시
.pytest_cache/
.ruff_cache/

# 노트북·에디터·운영체제 임시 파일
.ipynb_checkpoints/
tempCodeRunnerFile.py
.DS_Store
Thumbs.db

# 제공 자료: 자리표시 파일만 추적
/data/**
!/data/**/
!/data/**/.gitkeep

# 팀이 각 난이도 자료로 작성한 평가 세트. 팀원이 같은 기준으로 채점하도록 질문과 기대 답변·출처를 함께 추적한다.
# 제공 데이터셋의 원본·정답 파일은 계속 제외한다.
!/data/*/evaluation/custom_questions.json
!/data/*/evaluation/custom.json

# 로컬 모델·정제본·색인·전체 실행 기록 (공식 제출 결과는 reports/)
/artifacts/
/storage/
/models/
/logs/
