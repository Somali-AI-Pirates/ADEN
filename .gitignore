# Python 바이트코드
__pycache__/
*.py[cod]

# 가상환경과 비밀값 (.env.example만 공유)
.venv
env/
venv/
ENV/
.env
.env.*
!.env.example
.envrc
.pypirc

# setuptools 빌드·배포 산출물
/build/
/dist/
/*.egg-info/

# 현재 사용하는 검사 도구의 캐시
.pytest_cache/
.ruff_cache/

# 노트북·에디터·운영체제 임시 파일
.ipynb_checkpoints/
tempCodeRunnerFile.py
.DS_Store
Thumbs.db

# 제공 자료: 자리표시 파일만 추적
/data/**
!/data/**/
!/data/**/.gitkeep

# 팀이 검토하는 정제 지식 스냅샷. 원본·평가 정답·추출 캐시는 계속 제외한다.
!/data/curated/
!/data/curated/**/
!/data/curated/*/rules.jsonl
!/data/curated/*/sources.jsonl
!/data/curated/*/cases.jsonl
!/data/curated/*/manifest.json
!/data/curated/*/validation_report.json
!/data/curated/*/records/*.jsonl

# 로컬 모델·색인·전체 실행 기록 (공식 제출 결과는 reports/)
/artifacts/
/storage/
/models/
/logs/
